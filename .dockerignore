# Keeps local files out of the image build. Nothing listed here is needed to build,
# and several of them are private: .env holds real keys, config/ holds a live
# database and encryption key, and .git holds history.
.git
.github
.*
.env
.env.*
config/
downloads/
movies/
tv/
music/
*.exe
*.db
*.db-*
secret.key
tmp_*
web/node_modules
web/dist
# Documentation is not part of the image
*.md
# ...except the licence list, which ships in the image.
!THIRD_PARTY_NOTICES.md
# The user guide inside the app is built from the pages in docs/ (web/tools/build-guide.mjs),
# so those pages reach the build. Pictures and the generated reference stay out.
docs/*
!docs/*.md

website/
